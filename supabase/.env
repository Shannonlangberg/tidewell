# Local defaults for the env() references in supabase/config.toml. Loaded by the Supabase CLI
# (dotenvx) for `supabase start`; CI and the hosted project set the real values in their own env.
#
# TURNSTILE_SECRET_KEY: Cloudflare's published always-pass test secret. Any token passes locally.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
