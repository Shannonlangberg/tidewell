{
  "name": "tidewell",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "next build",
    "start": "next start -p 3210",
    "lint": "eslint .",
    "seed:local": "node --env-file=.env.local supabase/parked-tidewell/seed.mts",
    "test": "node --test \"lib/**/*.test.mts\"",
    "hq:seed": "node --env-file=.env.local scripts/hq/seed-local.mts",
    "hq:session": "node --env-file=.env.local scripts/hq/dev-session.mts",
    "hq:shot": "node --env-file=.env.local scripts/hq/screenshot.mts",
    "hq:bootstrap": "node --env-file-if-exists=.env.production.local scripts/hq/bootstrap-director.mts",
    "hq:code": "node --env-file-if-exists=.env.production.local scripts/hq/issue-code.mts"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "jose": "^6.2.12",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
