# PLANTED. — environment variables
#
# Copy this file to .env.local (gitignored) and fill in what you need. Every
# variable is optional for local development: the public marketing site runs
# with none of them set.
#
# Three groups:
#   1. The public site         — base URL, enquiry delivery, Turnstile
#   2. The parked Tidewell app — Supabase (only needed to work on /app, /stay)
#   3. Local tooling           — the seed script
#
# On Netlify these are set under Site configuration → Environment variables.
# Anything named NEXT_PUBLIC_* is compiled into the browser bundle, so it is
# public by definition. Never put a secret behind that prefix.


# ───────────────────────────────────────────────────────────────────────────
# 1. THE PUBLIC SITE
# ───────────────────────────────────────────────────────────────────────────

# The site's own origin, e.g. https://plantedgroup.com.au
# Read by app/sitemap.ts and app/robots.ts to build absolute URLs.
# CONTACT.url in lib/planted.ts takes precedence when it is set.
# Absent (and CONTACT.url null): both fall back to the placeholder origin
# https://planted.invalid — well-formed, obviously fake, and must not reach
# production. Setting this is on the pre-launch checklist in README.md.
NEXT_PUBLIC_SITE_URL=


# ── Enquiry delivery ───────────────────────────────────────────────────────
# Read by lib/enquiries.ts, which keeps the authoritative notes at the top of
# that file. Adapters are tried in the order below; the first that is both
# configured and successful wins.
#
# When NOTHING here is configured:
#   • in development the enquiry is logged to the server console and treated
#     as delivered, so the forms can be exercised end to end;
#   • in production delivery FAILS loudly. The person is told the form is not
#     connected yet and the server logs which variables are missing. Nobody is
#     ever shown a success message for an enquiry that went nowhere.

# Resend API key (re_...). With ENQUIRY_TO_EMAIL, enquiries are emailed via
# https://api.resend.com/emails. Absent: the email adapter is skipped.
RESEND_API_KEY=

# The address enquiries are delivered to. Required for the email adapter —
# RESEND_API_KEY alone does nothing. Absent: the email adapter is skipped.
ENQUIRY_TO_EMAIL=

# Optional sender, e.g. "PLANTED. Website <enquiries@plantedgroup.com.au>".
# The domain must be verified in Resend.
# Absent: falls back to Resend's shared testing sender
# "PLANTED. Website <onboarding@resend.dev>", which only delivers to the Resend
# account owner's own address. Set a verified sender before launch.
ENQUIRY_FROM_EMAIL=

# Optional HTTPS endpoint that receives each enquiry as JSON (POST). The hook
# for a CRM or a database later. Absent: the webhook adapter is skipped.
ENQUIRY_WEBHOOK_URL=

# Optional shared secret, sent with the webhook as the X-Enquiry-Secret header
# so the receiver can authenticate the call.
# Absent: the webhook is posted without that header.
ENQUIRY_WEBHOOK_SECRET=


# ── Cloudflare Turnstile ───────────────────────────────────────────────────
# The spam check on the enquiry and rental appraisal forms, and on the parked
# app's sign-in form. Both keys come from the same Turnstile widget.
#
# Cloudflare's always-passing test pair for local work:
#   site key   1x00000000000000000000AA
#   secret     1x0000000000000000000000000000000AA

# Site key. Read by the enquiry pages and by app/app/page.tsx.
# Absent: the widget is not rendered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Secret key, verified server-side on every enquiry submission.
# Absent: the Turnstile check is skipped entirely.
#
# NOTE: next.config.mjs currently allows the Turnstile script and iframe on
# /app only. Before these keys are set in production, /rental-appraisal and
# /contact need the same CSP exception or the widget will be blocked.
TURNSTILE_SECRET_KEY=


# ───────────────────────────────────────────────────────────────────────────
# 2. THE PARKED TIDEWELL APP  (/app, /stay, supabase/)
# ───────────────────────────────────────────────────────────────────────────
# Only needed to work on the parked product app. The PLANTED. marketing site
# never reads these. `supabase status -o env` prints the local values once
# `supabase start` is up.

# Supabase project URL. Local stack: http://127.0.0.1:54321
# Read by lib/supabase/env.ts, which throws if it is missing, and by
# next.config.mjs to build the Content-Security-Policy allowlist.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe in the browser: RLS applies to
# every query. Read by lib/supabase/env.ts, which throws if it is missing.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server only. Bypasses RLS, so it is read by
# exactly one file, lib/supabase/secret.ts, and only the routes listed in
# docs/backend-design.md section 6 may import that file (ESLint enforces the
# boundary — see SECRET_KEY_ALLOWED in eslint.config.mjs).
SUPABASE_SECRET_KEY=

# Local stack only. The hosted project signs tokens with asymmetric keys and
# lib/auth.ts verifies them against the project's JWKS; this HS256 secret is
# the fallback when the JWKS has no keys (an older local CLI).
# Leave empty in production.
SUPABASE_JWT_SECRET=


# ───────────────────────────────────────────────────────────────────────────
# 3. LOCAL TOOLING
# ───────────────────────────────────────────────────────────────────────────

# `npm run seed:local` refuses to run against anything but 127.0.0.1 or
# localhost unless this is set to 1. Set it only for a Supabase branch
# database, never for production. See supabase/seed.mts.
SEED_ALLOW_REMOTE=
