# Tidewell environment. Copy to .env.local for the local stack (gitignored).
# `supabase status -o env` prints the local values once `supabase start` is up.

# Supabase project URL. Local stack: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...). Safe in the browser: RLS applies to every query.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server only. Bypasses RLS, so it is read by exactly one
# file, lib/supabase/secret.ts, and only the routes listed in docs/backend-design.md
# section 6 may import that file (ESLint enforces the boundary).
SUPABASE_SECRET_KEY=

# Local stack only. The hosted project signs tokens with asymmetric keys and
# lib/auth.ts verifies them against the project's JWKS; this HS256 secret is the
# fallback when the JWKS has no keys (an older local CLI). Leave empty in production.
SUPABASE_JWT_SECRET=

# Cloudflare Turnstile site key for the sign-in form. When empty the widget is not
# rendered. Cloudflare's always-passing test key for local work: 1x00000000000000000000AA
# (pair it with Supabase's captcha setting and the test secret 1x0000000000000000000000000000000AA).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
